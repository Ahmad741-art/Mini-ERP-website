# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mini-erp

# JWT Secret (använd en stark, slumpmässig sträng i produktion)
JWT_SECRET=din_supersecret_jwt_key_byt_ut_mig

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Expiration
JWT_EXPIRE=7d

# CORS Origin (frontend URL)
CORS_ORIGIN=http://localhost:3000